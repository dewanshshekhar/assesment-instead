{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instead.example/schemas/tfas/1.0.0/render-plan.schema.json",
  "title": "Render Plan",
  "description": "The intermediate representation a template compiles to. Self-contained: a consumer holding only a plan and the source PDF can draw a correct page.",
  "type": "object",
  "required": [
    "planVersion",
    "templateId",
    "templateRevision",
    "taxYear",
    "source",
    "geometry",
    "placements",
    "statements",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "planVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version of the plan format, independent of the template specVersion."
    },
    "templateId": { "type": "string" },
    "templateRevision": { "type": "string" },
    "taxYear": { "type": "integer" },
    "source": {
      "type": "object",
      "required": ["filename", "sha256", "pageCount"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pageCount": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "geometry": {
      "type": "object",
      "required": ["unit", "origin", "pages"],
      "additionalProperties": false,
      "properties": {
        "unit": { "const": "pt" },
        "origin": { "const": "top-left" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["width", "height"],
            "additionalProperties": false,
            "properties": {
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "rotation": { "enum": [0, 90, 180, 270] }
            }
          }
        }
      }
    },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placedText" } },
    "statements": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },

  "$defs": {
    "rect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },

    "placedText": {
      "type": "object",
      "description": "One fully resolved string. Every presentation property is required: a consumer must never need to apply an inheritance rule of its own.",
      "required": [
        "fieldId",
        "page",
        "rect",
        "text",
        "font",
        "size",
        "color",
        "align",
        "vAlign",
        "padding",
        "overflow",
        "minSize",
        "lineHeight"
      ],
      "additionalProperties": false,
      "properties": {
        "fieldId": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 0 },
        "rect": { "$ref": "#/$defs/rect" },
        "text": { "type": "string" },
        "font": {
          "enum": ["Helvetica", "Helvetica-Bold", "Courier", "Courier-Bold", "Times-Roman"]
        },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "align": { "enum": ["left", "center", "right"] },
        "vAlign": { "enum": ["top", "middle", "bottom"] },
        "padding": {
          "type": "object",
          "description": "Resolved on all four sides. A checkbox always resolves to zero.",
          "required": ["top", "right", "bottom", "left"],
          "additionalProperties": false,
          "properties": {
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 }
          }
        },
        "overflow": { "enum": ["error", "shrink", "truncate", "ellipsis", "wrap"] },
        "minSize": { "type": "number", "exclusiveMinimum": 0 },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "cells": {
          "type": "array",
          "description": "Per-character cells for a comb field. Derived from the template and carried here so it cannot be re-derived differently downstream.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["x", "width", "char"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "char": { "type": "string", "maxLength": 1 }
            }
          }
        }
      }
    },

    "statement": {
      "type": "object",
      "required": ["statementId", "title", "sourceEntryId", "columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "statementId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "sourceEntryId": { "type": "string", "minLength": 1 },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": { "enum": ["error", "warning"] },
        "code": { "type": "string", "minLength": 1 },
        "entryId": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
